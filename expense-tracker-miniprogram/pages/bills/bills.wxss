.page {
  min-height: 100vh;
  padding-bottom: calc(var(--spacing-24) + env(safe-area-inset-bottom) + 120rpx);
}

.bills-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-24);
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.page-header-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-kicker {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.header-actions {
  display: flex;
  align-items: center;
}

.edit-btn {
  font-size: 28rpx;
  color: var(--accent-primary);
  font-weight: 700;
  padding: 14rpx 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(22, 124, 116, 0.08);
}

.edit-btn.done {
  color: var(--text-secondary);
  background: rgba(32, 48, 58, 0.06);
}

.summary-strip {
  display: flex;
  gap: 16rpx;
}

.summary-card {
  flex: 1;
  padding: 24rpx 22rpx;
  border-radius: 30rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.summary-card.expense {
  background: linear-gradient(135deg, #173B44 0%, #1B675F 100%);
}

.summary-card.income {
  background: linear-gradient(135deg, #EAF6F1 0%, #D6EEE8 100%);
}

.summary-card.neutral {
  background: linear-gradient(180deg, #FFFDF8 0%, #F6EFE5 100%);
}

.summary-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.summary-card.expense .summary-label {
  color: rgba(255, 255, 255, 0.72);
}

.summary-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.summary-card.expense .summary-value {
  color: #fff;
}

.summary-card.income .summary-value {
  color: var(--accent-primary);
}

.summary-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-128) var(--spacing-32);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-24);
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: var(--spacing-8);
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.date-group {
  margin-bottom: var(--spacing-16);
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx 14rpx;
}

.date-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.date-count {
  padding: 6rpx 12rpx;
  border-radius: var(--radius-pill);
  background: rgba(22, 124, 116, 0.08);
  font-size: 20rpx;
  color: var(--accent-primary);
  font-weight: 700;
}

.date-totals {
  display: flex;
  gap: var(--spacing-16);
}

.date-total {
  font-size: 22rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.date-total.expense {
  color: var(--text-primary);
}

.date-total.income {
  color: var(--accent-primary);
}

.bill-list {
  background: rgba(255, 253, 248, 0.86);
  border-radius: 32rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.bill-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-24) var(--spacing-32);
  border-bottom: 1rpx solid var(--border-subtle);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.bill-item:last-child {
  border-bottom: none;
}

.bill-item.edit-mode {
  padding-left: var(--spacing-24);
}

.bill-item.selected {
  background: rgba(22, 124, 116, 0.08);
}

.bill-item-hover {
  transform: scale(0.98);
  background: rgba(22, 124, 116, 0.04);
  border-radius: var(--radius-lg);
}

.bill-checkbox {
  padding-right: var(--spacing-20);
  flex-shrink: 0;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: var(--accent-primary);
  border-color: var(--accent-primary);
}

.checkbox-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.bill-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.bill-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-20);
  flex-shrink: 0;
}

.bill-icon.income {
  background: rgba(22, 124, 116, 0.12);
}

.bill-icon.expense {
  background: rgba(216, 111, 77, 0.12);
}

.icon-emoji {
  font-size: 32rpx;
}

.bill-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.bill-category {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-4);
}

.bill-time {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.bill-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bill-tag {
  padding: 6rpx 12rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  font-weight: 700;
}

.bill-tag.income {
  background: rgba(22, 124, 116, 0.08);
  color: var(--accent-primary);
}

.bill-tag.expense {
  background: rgba(216, 111, 77, 0.1);
  color: var(--accent-secondary);
}

.bill-remark {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  margin-top: var(--spacing-4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-amount-wrapper {
  flex-shrink: 0;
  margin-left: var(--spacing-16);
}

.bill-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
  display: block;
}

.bill-amount.income {
  color: var(--accent-primary);
}

.bill-amount.expense {
  color: var(--text-primary);
}

.batch-action-bar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: rgba(244, 239, 230, 0.92);
  padding: var(--spacing-16) var(--spacing-20);
  margin-bottom: var(--spacing-16);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: var(--shadow-xs);
}

.selected-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.action-btns {
  display: flex;
  gap: var(--spacing-24);
}

.action-btn {
  display: flex;
  align-items: center;
  gap: var(--spacing-8);
  padding: var(--spacing-16) var(--spacing-32);
  border-radius: var(--radius-full);
  transition: all 0.2s ease;
}

.action-btn.delete {
  background: rgba(216, 111, 77, 0.12);
}

.action-btn.delete:active {
  background: rgba(216, 111, 77, 0.2);
  transform: scale(0.96);
}

.action-icon {
  font-size: 28rpx;
}

.action-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent-secondary);
}
