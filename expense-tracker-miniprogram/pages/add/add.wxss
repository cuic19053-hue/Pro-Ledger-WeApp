.page {
  min-height: 100vh;
  padding-bottom: calc(var(--spacing-24) + env(safe-area-inset-bottom) + 24rpx);
}

.add-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-24);
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.page-header-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-kicker {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.header-date-badge {
  padding: 14rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(22, 124, 116, 0.08);
  border: 1rpx solid rgba(22, 124, 116, 0.12);
}

.header-date-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-primary);
}

.type-tabs {
  display: flex;
  background: rgba(255, 253, 248, 0.82);
  border-radius: 30rpx;
  padding: var(--spacing-8);
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.type-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-20) var(--spacing-16);
  border-radius: var(--radius-lg);
  transition: all 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
  position: relative;
  z-index: 2;
}

.type-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-secondary);
  transition: color 0.3s ease;
}

.type-tab.active .type-text {
  color: var(--color-white);
}

.type-indicator {
  position: absolute;
  top: var(--spacing-8);
  left: var(--spacing-8);
  width: calc(50% - var(--spacing-8));
  height: calc(100% - var(--spacing-16));
  background: var(--accent-gradient);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(22, 124, 116, 0.2);
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 1;
}

.amount-card {
  background: linear-gradient(180deg, #FFFDF8 0%, #F7F1E8 100%);
  border-radius: 40rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: var(--shadow-card);
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.amount-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}

.amount-wrapper {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: var(--spacing-8);
}

.currency {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.amount-display {
  font-size: 88rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  min-width: 80rpx;
  transition: transform 0.15s ease;
}

.amount-bounce {
  animation: amountBounce 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes amountBounce {
  0% { transform: scale(1); }
  40% { transform: scale(1.06); }
  100% { transform: scale(1); }
}

.amount-category-hint {
  margin-top: var(--spacing-16);
}

.amount-focus {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
}

.selected-category-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(22, 124, 116, 0.08);
}

.selected-category-label {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.selected-category-value {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-primary);
}

.amount-tip {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.section-card {
  padding: 28rpx;
  border-radius: 34rpx;
  background: rgba(255, 253, 248, 0.84);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-kicker {
  display: block;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-8);
  padding: var(--spacing-20) var(--spacing-24);
  background: linear-gradient(180deg, #FFFDF8 0%, #F6EFE5 100%);
  border-radius: 28rpx;
  width: calc((100% - 48rpx) / 4);
  box-shadow: var(--shadow-xs);
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.category-item.bounce {
  animation: categoryBounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes categoryBounce {
  0% { transform: scale(1); }
  30% { transform: scale(0.88); }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.category-item.selected {
  background: linear-gradient(135deg, #173B44 0%, #167C74 100%);
  border-color: rgba(22, 124, 116, 0.18);
  box-shadow: 0 12rpx 28rpx rgba(22, 124, 116, 0.22);
}

.category-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(22, 124, 116, 0.08);
  border-radius: 20rpx;
  transition: background 0.3s ease;
}

.category-item.selected .category-icon-wrap {
  background: rgba(255, 255, 255, 0.2);
}

.category-icon {
  font-size: 32rpx;
}

.category-name {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  transition: color 0.3s ease;
  text-align: center;
}

.category-item.selected .category-name {
  color: var(--color-white);
  font-weight: 600;
}

.section-header.compact {
  margin-bottom: 16rpx;
}

.remark-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 var(--spacing-24);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  background: #FFFDF8;
  border-radius: 24rpx;
  box-shadow: var(--shadow-xs);
}

.keyboard {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-12);
  padding: var(--spacing-20);
  border-radius: var(--radius-2xl);
}

.glass-keyboard {
  background: rgba(255, 253, 248, 0.74);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow: var(--shadow-keyboard), inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.keyboard-row {
  display: flex;
  gap: var(--spacing-12);
}

.keyboard-key {
  flex: 1;
  height: 100rpx;
  background: #FFFDF8;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-primary);
  box-shadow: var(--shadow-xs);
  transition: all 0.12s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.keyboard-key-hover {
  transform: scale(0.94);
  background: var(--bg-tertiary);
  box-shadow: none;
}

.keyboard-key.action {
  background: rgba(22, 124, 116, 0.08);
  color: var(--accent-primary);
}

.keyboard-key.action.keyboard-key-hover {
  background: var(--accent-primary);
  color: white;
}

.keyboard-key.delete {
  font-size: 36rpx;
}

.delete-icon {
  font-size: 40rpx;
  font-weight: 300;
}

.action-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: stretch;
}

.action-tools {
  display: flex;
  gap: var(--spacing-16);
}

.action-tools picker {
  flex: 1;
}

.action-btn {
  height: 88rpx;
  padding: 0 var(--spacing-32);
  background: rgba(255, 253, 248, 0.84);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  box-shadow: var(--shadow-xs);
  transition: all 0.2s ease;
  flex: 1;
}

.action-btn:active {
  transform: scale(0.96);
  background: var(--bg-tertiary);
}

.date-btn {
  padding: 0 var(--spacing-24);
}

.save-btn {
  width: 100%;
  height: 92rpx;
  background: var(--bg-tertiary);
  color: var(--text-secondary);
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 26rpx;
  box-shadow: none;
  transition: all 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn.active {
  background: var(--accent-gradient);
  color: var(--color-white);
  box-shadow: 0 12rpx 28rpx rgba(22, 124, 116, 0.24);
}

.save-btn.active:active {
  transform: scale(0.97);
  box-shadow: 0 8rpx 18rpx rgba(22, 124, 116, 0.2);
}

.save-btn::after {
  border: none;
}

/* ========== 常用账单快捷选择 ========== */
.quick-bills-scroll {
  width: 100%;
  white-space: nowrap;
}

.quick-bills-list {
  display: inline-flex;
  gap: var(--spacing-16);
  padding: var(--spacing-4) 0;
}

.quick-bill-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-6);
  padding: var(--spacing-16) var(--spacing-24);
  background: linear-gradient(180deg, #FFFDF8 0%, #F7F1E8 100%);
  border-radius: 26rpx;
  min-width: 120rpx;
  box-shadow: var(--shadow-xs);
  transition: all 0.2s cubic-bezier(0.25, 0.1, 0.25, 1);
  border: 2rpx solid transparent;
}

.quick-bill-item-hover {
  transform: scale(0.95);
  background: rgba(22, 124, 116, 0.06);
  border-color: var(--accent-primary);
}

.quick-bill-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(22, 124, 116, 0.08);
  border-radius: 18rpx;
}

.quick-bill-icon {
  font-size: 28rpx;
}

.quick-bill-name {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-primary);
  white-space: nowrap;
}

.quick-bill-amount {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--accent-primary);
  font-variant-numeric: tabular-nums;
}

/* ========== 用途选择弹窗（底部抽屉） ========== */
.usage-drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.usage-drawer-mask.visible {
  opacity: 1;
  visibility: visible;
}

.usage-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: var(--bg-secondary);
  border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
  padding: var(--spacing-16) var(--spacing-32) calc(var(--spacing-32) + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.25, 0.1, 0.25, 1);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
  max-height: 70vh;
  overflow-y: auto;
}

.usage-drawer.visible {
  transform: translateY(0);
}

.usage-drawer-handle {
  width: 64rpx;
  height: 8rpx;
  background: var(--bg-tertiary);
  border-radius: var(--radius-pill);
  margin: 0 auto var(--spacing-24);
}

.usage-drawer-header {
  margin-bottom: var(--spacing-24);
}

.usage-drawer-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.usage-drawer-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.usage-drawer-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-12);
}

.usage-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-24) var(--spacing-20);
  background: var(--bg-primary);
  border-radius: var(--radius-xl);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.usage-item-hover {
  transform: scale(0.98);
  background: rgba(22, 124, 116, 0.04);
}

.usage-item.selected {
  border-color: var(--accent-primary);
  background: rgba(22, 124, 116, 0.06);
}

.usage-item-left {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4);
  flex: 1;
  min-width: 0;
}

.usage-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.usage-item-remark {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-item-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-primary);
  font-variant-numeric: tabular-nums;
  margin-left: var(--spacing-16);
  flex-shrink: 0;
}
