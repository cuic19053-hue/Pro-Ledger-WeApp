/* ============================================
   预算页面样式
   ============================================ */

.page {
  min-height: 100vh;
  background: var(--bg-primary);
  padding-bottom: calc(var(--spacing-24) + env(safe-area-inset-bottom));
}

.page-header {
  padding: var(--spacing-32) var(--spacing-24) var(--spacing-16);
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.page-content {
  padding-bottom: var(--spacing-24);
}

/* ========== 警告横幅 ========== */
.budget-warning-banner {
  display: flex;
  align-items: center;
  gap: var(--spacing-16);
  padding: var(--spacing-20) var(--spacing-24);
  background: linear-gradient(135deg, #FFF5E6 0%, #FFF0DB 100%);
  border: 2rpx solid #FFD199;
  border-radius: var(--radius-lg);
  margin: 0 var(--spacing-24) var(--spacing-24);
}

.budget-warning-banner .warning-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.budget-warning-banner .warning-content {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4);
}

.budget-warning-banner .warning-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #B35900;
}

.budget-warning-banner .warning-desc {
  font-size: 24rpx;
  color: #E67300;
}

/* ========== 预算概览卡片 ========== */
.budget-overview-card {
  position: relative;
  overflow: hidden;
}

.budget-overview-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--accent-gradient);
}

.overview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-16);
}

.overview-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  letter-spacing: 0.3rpx;
}

.overview-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: var(--spacing-16);
}

.amount-currency {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-right: var(--spacing-8);
}

.amount-value {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.amount-value.text-danger {
  color: var(--color-danger-600);
}

.overview-remaining {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-16) var(--spacing-20);
  background: var(--color-primary-50);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-24);
}

.overview-remaining.over {
  background: var(--color-danger-50);
}

.remaining-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.remaining-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent-strong);
}

.overview-remaining.over .remaining-value {
  color: var(--color-danger-600);
}

.overview-progress {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-12);
}

.progress-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: right;
}

.progress-text.text-danger {
  color: var(--color-danger-600);
}

.text-danger {
  color: var(--color-danger-600) !important;
}

/* ========== 编辑卡片 ========== */
.edit-card {
  margin-bottom: var(--spacing-24);
}

.edit-section {
  margin-bottom: 0;
}

.edit-section-header {
  display: flex;
  align-items: baseline;
  gap: var(--spacing-8);
  margin-bottom: var(--spacing-16);
}

.edit-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.edit-section-subtitle {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.edit-input-container {
  display: flex;
  align-items: center;
  background: var(--bg-tertiary);
  border-radius: var(--radius-lg);
  padding: var(--spacing-16) var(--spacing-20);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.edit-input-container:focus-within {
  border-color: var(--accent-primary);
  background: var(--bg-elevated);
}

.edit-currency {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-right: var(--spacing-12);
}

.edit-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1;
}

.edit-input::placeholder {
  color: var(--text-tertiary);
}

/* ========== 分类编辑列表 ========== */
.category-edit-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-12);
}

.category-edit-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-16);
  background: var(--bg-tertiary);
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
}

.category-edit-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-16);
  flex: 1;
}

.category-icon {
  width: 72rpx;
  height: 72rpx;
  background: var(--bg-elevated);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: var(--shadow-xs);
}

.category-info {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4);
}

.category-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.category-used {
  font-size: 22rpx;
}

.category-edit-right {
  display: flex;
  align-items: center;
  gap: var(--spacing-8);
}

.currency-prefix {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.category-limit-input {
  width: 160rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: var(--spacing-8) var(--spacing-12);
  background: var(--bg-elevated);
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.category-limit-input:focus {
  border-color: var(--accent-primary);
}

.category-limit-input::placeholder {
  color: var(--text-tertiary);
}

.edit-actions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-16);
  margin-top: var(--spacing-32);
}

/* ========== 分类预算列表 ========== */
.section-header {
  margin-bottom: var(--spacing-16);
}

.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
  text-transform: uppercase;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-16);
}

.category-card {
  transition: all 0.2s ease;
}

.category-card:active {
  transform: scale(0.98);
}

.category-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-16);
}

.category-card-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-16);
  flex: 1;
}

.category-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  background: var(--color-primary-50);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.category-card-info {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4);
}

.category-card-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.category-card-amount {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.category-card-amount.over {
  color: var(--color-danger-600);
}

.category-card-right {
  display: flex;
  align-items: center;
}

.category-percent {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent-strong);
}

.category-percent.over {
  color: var(--color-danger-600);
}

.category-warning {
  margin-bottom: var(--spacing-12);
}

.category-warning-text {
  font-size: 22rpx;
  color: #E67300;
  font-weight: 500;
}

.category-card-progress {
  margin-top: var(--spacing-8);
}

/* ========== 操作区域 ========== */
.action-section {
  margin-top: var(--spacing-32);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-16);
}

.action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.2s ease;
}

.action-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.action-card.danger .action-label {
  color: var(--color-danger-600);
}

.action-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-16);
}

.action-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  background: var(--color-primary-50);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon-wrapper.danger {
  background: var(--color-danger-50);
}

.action-icon {
  font-size: 32rpx;
}

.action-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.action-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}