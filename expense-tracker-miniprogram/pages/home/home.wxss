.page {
  min-height: 100vh;
  padding-bottom: calc(var(--spacing-24) + env(safe-area-inset-bottom) + 180rpx);
}

.home-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-24);
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 40rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #173B44 0%, #1B675F 56%, #3DA092 100%);
  box-shadow: 0 24rpx 54rpx rgba(20, 46, 55, 0.22);
  color: #fff;
}

.hero-card::before,
.hero-card::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-card::before {
  width: 220rpx;
  height: 220rpx;
  top: -80rpx;
  right: -40rpx;
}

.hero-card::after {
  width: 160rpx;
  height: 160rpx;
  bottom: -50rpx;
  left: -30rpx;
}

.hero-top,
.hero-meta-grid,
.hero-budget-panel {
  position: relative;
  z-index: 1;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 44rpx;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-8);
}

.hero-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-title {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
}

.hero-badge {
  padding: 12rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.hero-badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.hero-amount-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
}

.hero-currency {
  font-size: 42rpx;
  font-weight: 600;
  margin-right: 10rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-amount {
  font-size: 84rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: #fff;
}

.hero-meta-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.hero-meta-card {
  flex: 1;
  min-width: 0;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.hero-meta-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-meta-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.hero-meta-value.income {
  color: #E1FFF9;
}

.hero-meta-value.expense {
  color: #FFE3D3;
}

.hero-budget-panel {
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.hero-budget-panel.empty {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-budget-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.hero-budget-title,
.hero-budget-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.hero-budget-progress {
  width: 100%;
  height: 12rpx;
  border-radius: var(--radius-pill);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.2);
  margin-bottom: 14rpx;
}

.hero-budget-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, #FCE2D4 0%, #FFFFFF 100%);
}

.hero-budget-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.section-shell {
  padding: 30rpx;
  border-radius: 36rpx;
  background: rgba(255, 253, 248, 0.84);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-kicker {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-more {
  padding: 14rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(22, 124, 116, 0.08);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-primary);
}

.quick-bills-scroll {
  width: 100%;
  white-space: nowrap;
}

.quick-bills-list {
  display: inline-flex;
  gap: 18rpx;
  padding: 4rpx 2rpx;
}

.quick-bill-card {
  width: 168rpx;
  flex-shrink: 0;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 22rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFFDF8 0%, #F7F1E8 100%);
  box-shadow: var(--shadow-xs);
  border: 1rpx solid rgba(32, 48, 58, 0.06);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-bill-card-hover {
  transform: translateY(-4rpx) scale(0.98);
  box-shadow: var(--shadow-sm);
}

.quick-bill-icon {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.quick-bill-icon.expense {
  background: rgba(216, 111, 77, 0.12);
}

.quick-bill-icon.income {
  background: rgba(22, 124, 116, 0.12);
}

.quick-bill-emoji {
  font-size: 34rpx;
}

.quick-bill-name {
  max-width: 128rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.quick-bill-amount {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-primary);
  font-variant-numeric: tabular-nums;
  margin-bottom: 8rpx;
}

.quick-bill-caption {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 18rpx;
  opacity: 0.45;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.bill-list {
  display: flex;
  flex-direction: column;
}

.bill-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-subtle);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.bill-item:last-child {
  border-bottom: none;
}

.bill-item-hover {
  transform: scale(0.985);
  opacity: 0.9;
}

.bill-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.bill-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.bill-icon.income {
  background: rgba(22, 124, 116, 0.12);
}

.bill-icon.expense {
  background: rgba(216, 111, 77, 0.12);
}

.icon-emoji {
  font-size: 34rpx;
}

.bill-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.bill-category {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.bill-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bill-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.bill-type {
  padding: 6rpx 12rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  font-weight: 700;
}

.bill-type.income {
  background: rgba(22, 124, 116, 0.1);
  color: var(--accent-primary);
}

.bill-type.expense {
  background: rgba(216, 111, 77, 0.1);
  color: var(--accent-secondary);
}

.bill-amount {
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.bill-amount.income {
  color: var(--accent-primary);
}

.home-fab {
  background: linear-gradient(135deg, #173B44 0%, #167C74 100%);
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.usage-drawer-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(21, 39, 46, 0.36);
  z-index: 500;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.usage-drawer-overlay.show {
  opacity: 1;
  visibility: visible;
}

.usage-drawer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #FFFDF8;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -14rpx 40rpx rgba(20, 46, 55, 0.12);
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 72vh;
  overflow-y: auto;
}

.usage-drawer-overlay.show .usage-drawer {
  transform: translateY(0);
}

.usage-drawer-handle {
  width: 72rpx;
  height: 8rpx;
  background: rgba(32, 48, 58, 0.12);
  border-radius: var(--radius-pill);
  margin: 0 auto 24rpx;
}

.usage-drawer-header {
  margin-bottom: 24rpx;
}

.usage-drawer-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.usage-drawer-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.usage-drawer-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.usage-drawer-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background: #F7F1E8;
  border: 2rpx solid transparent;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.usage-drawer-item.default {
  background: rgba(22, 124, 116, 0.08);
  border-color: rgba(22, 124, 116, 0.18);
}

.usage-drawer-item-hover {
  transform: scale(0.985);
}

.usage-drawer-item-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.usage-drawer-item-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.usage-drawer-item-remark {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-drawer-item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 16rpx;
}

.usage-drawer-item-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent-primary);
  font-variant-numeric: tabular-nums;
}

.usage-drawer-item-badge {
  padding: 6rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-primary);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}
