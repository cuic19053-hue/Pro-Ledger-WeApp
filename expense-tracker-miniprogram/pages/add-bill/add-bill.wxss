.container {
  padding: 20rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 10rpx 0;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: -0.5rpx;
}

.close-btn {
  font-size: 28rpx;
  color: #64748b;
  background: none;
  border: none;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.close-btn:active {
  background: rgba(100, 116, 139, 0.1);
  transform: scale(0.95);
}

.type-tabs {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.type-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.type-tab::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 12rpx;
  background: transparent;
  transition: all 0.3s ease;
}

.type-tab:active::before {
  background: rgba(0, 0, 0, 0.05);
}

.type-tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
  transform: translateY(-2rpx);
}

.type-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
  transition: transform 0.3s ease;
}

.type-tab.active .type-icon {
  transform: scale(1.1);
}

.type-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #64748b;
}

.type-tab.active .type-text {
  color: white;
}

.quick-bills-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.quick-bills-scroll {
  width: 100%;
  white-space: nowrap;
}

.quick-bills-list {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 20rpx;
}

.quick-bill-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
  padding: 20rpx 16rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-bill-item:active {
  transform: scale(0.95);
  border-color: #667eea;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
}

.quick-bill-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.quick-bill-name {
  font-size: 22rpx;
  color: #475569;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.quick-bill-amount {
  font-size: 20rpx;
  color: #667eea;
  font-weight: 600;
}

.amount-section {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.currency-symbol {
  font-size: 48rpx;
  font-weight: 600;
  color: #64748b;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  font-size: 64rpx;
  font-weight: 700;
  text-align: left;
  border: none;
  outline: none;
  color: #1e293b;
  letter-spacing: -1rpx;
  padding: 0;
}

.amount-input.error {
  color: #ef4444;
}

.error-message {
  position: absolute;
  bottom: 16rpx;
  left: 30rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: #ef4444;
  text-align: center;
  animation: shake 0.3s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-5rpx); }
  75% { transform: translateX(5rpx); }
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #fafbfc;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.category-item::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(102, 126, 234, 0.05);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.category-item:active::after {
  opacity: 1;
}

.category-item:active {
  transform: scale(0.95);
}

.category-item.selected {
  border-color: #667eea;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
}

.category-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
  transition: transform 0.3s ease;
}

.category-item.selected .category-icon {
  transform: scale(1.15);
}

.category-name {
  font-size: 22rpx;
  color: #475569;
  text-align: center;
  font-weight: 500;
}

.category-item.selected .category-name {
  color: #667eea;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  transition: background 0.2s ease;
}

.picker:active {
  background: rgba(102, 126, 234, 0.05);
  margin: 0 -20rpx;
  padding: 20rpx;
}

.picker-text {
  font-size: 30rpx;
  color: #1e293b;
  font-weight: 500;
}

.picker-arrow {
  font-size: 40rpx;
  color: #94a3b8;
  font-weight: 300;
  transform: rotate(90deg);
}

.remark-input {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #1e293b;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx;
  background: #fafbfc;
  line-height: 1.6;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.remark-input:focus {
  border-color: #667eea;
  background: white;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 12rpx;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 1rpx;
}

.save-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.save-btn.disabled {
  opacity: 0.6;
  pointer-events: none;
}

.save-btn::after {
  border: none;
}

@media (max-width: 375px) {
  .category-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 12rpx;
  }
  
  .category-item {
    padding: 20rpx 8rpx;
  }
  
  .amount-input {
    font-size: 56rpx;
  }
}

@media (min-width: 768px) {
  .container {
    max-width: 600rpx;
    margin: 0 auto;
  }
  
  .category-grid {
    grid-template-columns: repeat(5, 1fr);
  }
}

/* 用途选择遮罩层 */
.usage-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 用途选择弹窗 */
.usage-selector {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1000;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* 用途选择弹窗头部 */
.usage-selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.usage-selector-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.usage-close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f8fafc;
  transition: all 0.2s ease;
}

.usage-close-btn:active {
  background: #e2e8f0;
  transform: scale(0.95);
}

.usage-close-icon {
  font-size: 32rpx;
  color: #64748b;
  font-weight: 300;
}

/* 用途列表 */
.usage-list {
  flex: 1;
  padding: 20rpx 30rpx 30rpx;
  overflow-y: auto;
}

/* 用途项 */
.usage-item {
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.usage-item:last-child {
  margin-bottom: 0;
}

.usage-item:active {
  transform: scale(0.98);
  border-color: #667eea;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
}

.usage-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.usage-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.usage-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #667eea;
}

.usage-remark {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}