.api-status {
  padding: 32rpx 48rpx;
  margin: 0 48rpx 32rpx;
  background: linear-gradient(135deg, rgba(130, 194, 155, 0.1), rgba(94, 167, 122, 0.1));
  border-radius: 32rpx;
  border: 2rpx solid rgba(130, 194, 155, 0.2);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.api-status-icon {
  font-size: 48rpx;
}

.api-status-text {
  flex: 1;
}

.api-status-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
}

.api-status-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}

.api-status-action {
  padding: 16rpx 32rpx;
  background: var(--accent-end);
  color: white;
  border: none;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.analysis-section {
  margin-bottom: 32rpx;
}

.analysis-input-group {
  margin-bottom: 32rpx;
}

.analysis-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.picker-value {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  background: #F8FBF9;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 96rpx;
}

.quick-prompts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.prompt-chip {
  padding: 16rpx 32rpx;
  background: #F8FBF9;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-primary);
}

.prompt-chip.active {
  background: var(--accent-end);
  color: white;
}

.analysis-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  background: #F8FBF9;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.analyze-btn {
  width: 100%;
  height: 96rpx;
}

.analysis-result {
  margin: 0 48rpx 40rpx;
  padding: 40rpx;
  background: var(--bg-pure);
  border-radius: 32rpx;
  display: none;
}

.analysis-result.active {
  display: block;
}

.analysis-result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: block;
}

.analysis-result-content {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
}
