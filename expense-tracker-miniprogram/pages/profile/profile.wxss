.page {
  min-height: 100vh;
  padding-bottom: calc(var(--spacing-24) + env(safe-area-inset-bottom) + 120rpx);
}

.profile-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-24);
}

.page-header-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-kicker {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.profile-hero {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.user-card {
  background: linear-gradient(135deg, #173B44 0%, #1B675F 56%, #3DA092 100%);
  border-radius: 40rpx;
  padding: 34rpx;
  display: flex;
  align-items: center;
  gap: var(--spacing-24);
  box-shadow: 0 24rpx 54rpx rgba(20, 46, 55, 0.22);
  position: relative;
  overflow: hidden;
}

.user-card::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -30rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-emoji {
  font-size: 44rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-4);
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: white;
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.menu-arrow.light {
  color: rgba(255, 255, 255, 0.82);
}

.profile-metrics {
  display: flex;
  gap: 16rpx;
}

.metric-card {
  flex: 1;
  padding: 24rpx 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFFDF8 0%, #F6EFE5 100%);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.metric-card.accent {
  background: linear-gradient(180deg, #EAF6F1 0%, #D9EEE8 100%);
}

.metric-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.metric-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.metric-card.accent .metric-value {
  color: var(--accent-primary);
}

.budget-banner {
  padding: 24rpx 24rpx 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 253, 248, 0.84);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.budget-banner.muted {
  background: linear-gradient(180deg, #FFFDF8 0%, #F6EFE5 100%);
}

.budget-banner-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.budget-banner-title,
.budget-banner-value {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.budget-banner-value {
  color: var(--accent-primary);
}

.budget-progress-track {
  width: 100%;
  height: 12rpx;
  border-radius: var(--radius-pill);
  overflow: hidden;
  background: rgba(22, 124, 116, 0.1);
  margin-bottom: 14rpx;
}

.budget-progress-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--accent-gradient);
}

.budget-banner-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.menu-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-kicker {
  display: block;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.menu-list {
  background: rgba(255, 253, 248, 0.84);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-28) var(--spacing-32);
  border-bottom: 1rpx solid var(--border-subtle);
  transition: all 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  transform: scale(0.98);
  background: rgba(22, 124, 116, 0.04);
}

.menu-item.danger .menu-label {
  color: var(--accent-secondary);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-20);
  flex: 1;
}

.menu-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon.purple {
  background: rgba(22, 124, 116, 0.12);
}

.menu-icon.orange {
  background: rgba(216, 111, 77, 0.12);
}

.menu-icon.blue {
  background: rgba(94, 155, 230, 0.12);
}

.menu-icon.rose {
  background: rgba(212, 181, 176, 0.3);
}

.menu-icon.green {
  background: rgba(52, 199, 89, 0.12);
}

.menu-icon.amber {
  background: rgba(255, 179, 0, 0.12);
}

.menu-icon.gray {
  background: rgba(142, 142, 147, 0.12);
}

.icon-emoji {
  font-size: 32rpx;
}

.menu-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.menu-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.version-info {
  text-align: center;
  padding: var(--spacing-48) 0;
}

.version-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}
