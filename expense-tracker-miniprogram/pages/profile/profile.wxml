<view class="page profile-page">
  <view class="page-header animate-slideUp stagger-1">
    <view class="page-header-copy">
      <text class="page-kicker">ACCOUNT CENTER</text>
      <text class="large-title">我的</text>
    </view>
  </view>

  <view class="profile-hero animate-slideUp stagger-2">
    <view class="user-card" bindtap="editProfile">
      <view class="user-avatar">
        <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" class="avatar-img" mode="aspectFill"></image>
        <text wx:else class="avatar-emoji">👤</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '微信用户'}}</text>
        <text class="user-desc">点击编辑资料</text>
      </view>
      <text class="menu-arrow light">›</text>
    </view>

    <view class="profile-metrics">
      <view class="metric-card">
        <text class="metric-label">总记录</text>
        <text class="metric-value">{{recordCount}}</text>
      </view>
      <view class="metric-card">
        <text class="metric-label">活跃天数</text>
        <text class="metric-value">{{activeDays}}</text>
      </view>
      <view class="metric-card accent">
        <text class="metric-label">本月支出</text>
        <text class="metric-value">{{monthExpenseDisplay}}</text>
      </view>
    </view>

    <view class="budget-banner {{hasBudget ? '' : 'muted'}}">
      <view class="budget-banner-head">
        <text class="budget-banner-title">{{hasBudget ? '预算剩余' : '预算提醒'}}</text>
        <text class="budget-banner-value">{{hasBudget ? budgetPercent + '%' : '未设置'}}</text>
      </view>
      <view wx:if="{{hasBudget}}" class="budget-progress-track">
        <view class="budget-progress-fill" style="width: {{budgetPercent}}%;"></view>
      </view>
      <text class="budget-banner-text">{{hasBudget ? budgetRemainingDisplay + ' 可继续使用' : '设置预算后，可在这里持续跟踪月度节奏。'}}</text>
    </view>
  </view>

  <view class="menu-section animate-slideUp stagger-3">
    <view class="section-header">
      <view>
        <text class="section-kicker">SETTINGS</text>
        <text class="section-title">功能设置</text>
      </view>
    </view>

    <view class="menu-list">
      <view class="menu-item" bindtap="goToBudget" hover-class="menu-item-hover" hover-stay-time="150">
        <view class="menu-left">
          <view class="menu-icon purple">
            <text class="icon-emoji">💰</text>
          </view>
          <view class="menu-copy">
            <text class="menu-label">预算设置</text>
            <text class="menu-desc">管理月度预算和控制进度</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="goToQuickBills" hover-class="menu-item-hover" hover-stay-time="150">
        <view class="menu-left">
          <view class="menu-icon amber">
            <text class="icon-emoji">⚡</text>
          </view>
          <view class="menu-copy">
            <text class="menu-label">常用账单</text>
            <text class="menu-desc">维护快捷模板，提升记账效率</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="exportData" hover-class="menu-item-hover" hover-stay-time="150">
        <view class="menu-left">
          <view class="menu-icon orange">
            <text class="icon-emoji">📊</text>
          </view>
          <view class="menu-copy">
            <text class="menu-label">数据导出</text>
            <text class="menu-desc">支持 CSV 和 JSON 备份</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="goToAgreement" hover-class="menu-item-hover" hover-stay-time="150">
        <view class="menu-left">
          <view class="menu-icon blue">
            <text class="icon-emoji">📄</text>
          </view>
          <view class="menu-copy">
            <text class="menu-label">用户协议</text>
            <text class="menu-desc">查看服务条款和使用说明</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="goToPrivacy" hover-class="menu-item-hover" hover-stay-time="150">
        <view class="menu-left">
          <view class="menu-icon green">
            <text class="icon-emoji">🔒</text>
          </view>
          <view class="menu-copy">
            <text class="menu-label">隐私政策</text>
            <text class="menu-desc">了解数据存储与使用方式</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="goToAbout" hover-class="menu-item-hover" hover-stay-time="150">
        <view class="menu-left">
          <view class="menu-icon gray">
            <text class="icon-emoji">ℹ️</text>
          </view>
          <view class="menu-copy">
            <text class="menu-label">关于</text>
            <text class="menu-desc">查看版本信息与产品介绍</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-section animate-slideUp stagger-4">
    <view class="section-header">
      <view>
        <text class="section-kicker">ACCOUNT</text>
        <text class="section-title">账户</text>
      </view>
    </view>

    <view class="menu-list">
      <view class="menu-item" bindtap="feedback" hover-class="menu-item-hover" hover-stay-time="150">
        <view class="menu-left">
          <view class="menu-icon rose">
            <text class="icon-emoji">💬</text>
          </view>
          <view class="menu-copy">
            <text class="menu-label">意见反馈</text>
            <text class="menu-desc">告诉我们你希望优化的地方</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item danger" bindtap="cancelAccount" hover-class="menu-item-hover" hover-stay-time="150">
        <view class="menu-left">
          <view class="menu-icon gray">
            <text class="icon-emoji">🗑️</text>
          </view>
          <view class="menu-copy">
            <text class="menu-label">注销账号</text>
            <text class="menu-desc">删除账户与所有历史数据</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item danger" bindtap="logout" hover-class="menu-item-hover" hover-stay-time="150">
        <view class="menu-left">
          <view class="menu-icon gray">
            <text class="icon-emoji">🚪</text>
          </view>
          <view class="menu-copy">
            <text class="menu-label">退出登录</text>
            <text class="menu-desc">退出当前设备登录状态</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="version-info animate-slideUp stagger-5">
    <text class="version-text">版本 1.0.0</text>
  </view>
</view>
