<view class="page">
  <view class="header">
    <view class="nav-bar">
      <view class="nav-left" bindtap="goBack">
        <text class="nav-icon">‹</text>
        <text class="nav-text">返回</text>
      </view>
      <text class="nav-title">账单详情</text>
      <view class="nav-right">
        <text class="nav-action" bindtap="editBill">编辑</text>
      </view>
    </view>
  </view>

  <view class="content">
    <view class="amount-section">
      <text class="amount-label">{{bill.type === 'income' ? '收入' : '支出'}}</text>
      <text class="amount-value {{bill.type === 'income' ? 'income' : 'expense'}}">{{bill.amountDisplay}}</text>
    </view>

    <view class="info-section">
      <view class="info-item">
        <text class="info-label">分类</text>
        <view class="info-value">
          <text class="category-icon">{{bill.icon}}</text>
          <text class="category-name">{{bill.categoryName}}</text>
        </view>
      </view>

      <view class="info-item">
        <text class="info-label">时间</text>
        <text class="info-value">{{bill.dateLabel}}</text>
      </view>

      <view class="info-item" wx:if="{{bill.remark}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{bill.remark}}</text>
      </view>
    </view>

    <view class="action-section">
      <button class="btn btn-danger" bindtap="deleteBill">删除账单</button>
    </view>
  </view>
</view>