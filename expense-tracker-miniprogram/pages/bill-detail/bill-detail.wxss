.page {
  min-height: 100vh;
  background: var(--bg-primary);
}

.header {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--spacing-24);
}

.nav-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-8);
}

.nav-icon {
  font-size: 36rpx;
  color: var(--accent-primary);
  font-weight: bold;
}

.nav-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.nav-right {
  display: flex;
  align-items: center;
}

.nav-action {
  font-size: 28rpx;
  color: var(--accent-primary);
  font-weight: 500;
}

.content {
  padding: var(--spacing-32);
}

.amount-section {
  text-align: center;
  margin-bottom: var(--spacing-48);
  padding: var(--spacing-40) 0;
  background: var(--bg-secondary);
  border-radius: var(--radius-2xl);
}

.amount-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-12);
}

.amount-value {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.amount-value.income {
  color: #10B981;
}

.amount-value.expense {
  color: #EF4444;
}

.info-section {
  background: var(--bg-secondary);
  border-radius: var(--radius-2xl);
  margin-bottom: var(--spacing-32);
  overflow: hidden;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-24) var(--spacing-32);
  border-bottom: 1px solid var(--border-color);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.info-value {
  display: flex;
  align-items: center;
  gap: var(--spacing-12);
  font-size: 28rpx;
  color: var(--text-primary);
}

.category-icon {
  font-size: 32rpx;
}

.category-name {
  font-weight: 500;
}

.action-section {
  padding: var(--spacing-24) 0;
}

.btn {
  width: 100%;
  height: 88rpx;
  border: none;
  border-radius: var(--radius-xl);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-danger {
  background: #EF4444;
  color: white;
}

.btn-danger:active {
  background: #DC2626;
}