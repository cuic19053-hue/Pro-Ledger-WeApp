.page {
  min-height: 100vh;
  padding-bottom: calc(var(--spacing-24) + env(safe-area-inset-bottom) + 120rpx);
}

.stats-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-24);
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.page-header-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-kicker {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.period-badge {
  padding: 14rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(22, 124, 116, 0.08);
  border: 1rpx solid rgba(22, 124, 116, 0.12);
}

.period-badge-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-primary);
}

.stats-hero {
  display: flex;
  gap: 16rpx;
}

.stats-hero-main {
  flex: 1.35;
  padding: 30rpx 28rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #173B44 0%, #1B675F 56%, #3DA092 100%);
  box-shadow: var(--shadow-md);
}

.stats-hero-kicker {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.stats-hero-value {
  display: block;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1.4rpx;
  color: #fff;
  font-variant-numeric: tabular-nums;
  margin-bottom: 14rpx;
}

.stats-hero-note {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
}

.stats-hero-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mini-stat-card {
  flex: 1;
  border-radius: 30rpx;
  padding: 24rpx 22rpx;
  background: linear-gradient(180deg, #FFFDF8 0%, #F6EFE5 100%);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.mini-stat-card.income-card {
  background: linear-gradient(180deg, #EAF6F1 0%, #D9EEE8 100%);
}

.mini-stat-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.mini-stat-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.income-value {
  color: var(--accent-primary);
}

.chart-section {
  background: rgba(255, 253, 248, 0.86);
  border-radius: 34rpx;
  padding: var(--spacing-32);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-24);
}

.section-kicker {
  display: block;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-note {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.chart-wrapper {
  position: relative;
}

.chart-container {
  width: 100%;
  height: 320rpx;
  position: relative;
  margin-bottom: var(--spacing-16);
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

.chart-tooltip {
  position: absolute;
  background: var(--color-space-black);
  color: var(--color-white);
  padding: var(--spacing-12) var(--spacing-20);
  font-size: 24rpx;
  font-weight: 600;
  border-radius: var(--radius-lg);
  pointer-events: none;
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  white-space: nowrap;
  z-index: 10;
}

.chart-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 var(--spacing-16);
}

.chart-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.empty-state {
  padding: var(--spacing-64) var(--spacing-32);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-16);
  opacity: 0.4;
}

.empty-state .empty-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.category-section {
  background: rgba(255, 253, 248, 0.86);
  border-radius: 34rpx;
  padding: var(--spacing-32);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-24);
}

.category-bar-item {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-12);
}

.category-bar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-bar-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-12);
}

.category-bar-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.category-bar-icon {
  font-size: 28rpx;
}

.category-bar-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.category-bar-count {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.category-bar-amount {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.category-bar-track {
  width: 100%;
  height: 8rpx;
  background: var(--bg-tertiary);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.category-bar-fill {
  height: 100%;
  background: var(--accent-primary);
  border-radius: var(--radius-pill);
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.category-bar-fill.expense-fill {
  background: var(--accent-primary);
}

.category-bar-fill.income-fill {
  background: #10B981;
}

.income-amount {
  color: #10B981;
}

.category-tabs {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: var(--radius-pill);
  background: rgba(22, 124, 116, 0.06);
}

.category-tab {
  padding: 12rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  transition: all 0.3s ease;
}

.category-tab.active {
  color: #fff;
  background: var(--accent-gradient);
}

.empty-category {
  padding: var(--spacing-48) 0;
  text-align: center;
}

.empty-category-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
